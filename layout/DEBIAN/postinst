#!/bin/sh

killall -9 AIGate > /dev/null 2>&1

if [ -f /Library/LaunchDaemons/wiki.qaq.writenowservices.plist ]; then
    launchctl load -w /Library/LaunchDaemons/wiki.qaq.writenowservices.plist > /dev/null 2>&1
elif [ -f /var/jb/Library/LaunchDaemons/wiki.qaq.writenowservices.plist ]; then
    launchctl load -w /var/jb/Library/LaunchDaemons/wiki.qaq.writenowservices.plist > /dev/null 2>&1
else
    ROOTHIDE_PATH=$(ls -d /var/containers/Bundle/Application/.jbroot-*/Library/LaunchDaemons/wiki.qaq.writenowservices.plist)
    launchctl load -w $ROOTHIDE_PATH > /dev/null 2>&1
fi

exit 0